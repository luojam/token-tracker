[Unit]
Description=Caddy HTTPS proxy for Token Tracker
Wants=network-online.target token-tracker.service
After=network-online.target token-tracker.service var-lib-token\x2dtracker.mount
RequiresMountsFor=/var/lib/token-tracker
BindsTo=var-lib-token\x2dtracker.mount

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/token-tracker/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/token-tracker/caddy/config
ExecStartPre=/usr/bin/mountpoint -q /var/lib/token-tracker
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/token-tracker/caddy

[Install]
WantedBy=multi-user.target
